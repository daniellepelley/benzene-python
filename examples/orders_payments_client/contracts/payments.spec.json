{
  "schemaDialect": "openapi-3.0",
  "service": "payments-api",
  "messageEndpoint": "/benzene/invoke",
  "transports": [
    "api-gateway",
    "benzene",
    "sqs",
    "sns",
    "eventbridge"
  ],
  "contractHash": "sha256:c9ea464d64b78269e2b902bc02de4fec7bdaad66d548ce909383e8259e795f43",
  "registrationHash": "sha256:3f4102e2eec733b97f6584ffc5f97963f00d4f4b3b698efad43c5c899f2ac56d",
  "requests": [
    {
      "topic": "payments:capture",
      "httpMappings": [
        {
          "method": "POST",
          "path": "/payments"
        }
      ],
      "request": {
        "$ref": "#/components/schemas/CapturePayment"
      },
      "response": {
        "$ref": "#/components/schemas/PaymentDto"
      }
    },
    {
      "topic": "payments:get-all",
      "httpMappings": [
        {
          "method": "GET",
          "path": "/payments"
        }
      ],
      "request": {
        "type": "object"
      },
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/PaymentDto"
        }
      }
    }
  ],
  "events": [
    {
      "topic": "payment:captured",
      "message": {
        "$ref": "#/components/schemas/OutboundPaymentCaptured"
      }
    }
  ],
  "sends": [
    {
      "topic": "shipping:book",
      "request": {
        "$ref": "#/components/schemas/OutboundShipmentBook"
      }
    }
  ],
  "components": {
    "schemas": {
      "CapturePayment": {
        "type": "object",
        "properties": {
          "OrderId": {
            "type": "string"
          },
          "Amount": {
            "type": "number",
            "format": "double"
          },
          "Currency": {
            "type": "string"
          }
        },
        "required": [
          "Amount",
          "Currency",
          "OrderId"
        ]
      },
      "OutboundPaymentCaptured": {
        "type": "object",
        "properties": {
          "OrderId": {
            "type": "string",
            "nullable": true
          },
          "PaymentId": {
            "type": "string",
            "nullable": true
          },
          "Amount": {
            "type": "number",
            "format": "double"
          },
          "Currency": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "Amount",
          "Currency",
          "OrderId",
          "PaymentId"
        ]
      },
      "OutboundShipmentBook": {
        "type": "object",
        "properties": {
          "OrderId": {
            "type": "string",
            "nullable": true
          },
          "Carrier": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "Carrier",
          "OrderId"
        ]
      },
      "PaymentDto": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "nullable": true
          },
          "OrderId": {
            "type": "string",
            "nullable": true
          },
          "Amount": {
            "type": "number",
            "format": "double"
          },
          "Currency": {
            "type": "string",
            "nullable": true
          },
          "Status": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "Amount",
          "Currency",
          "Id",
          "OrderId",
          "Status"
        ]
      }
    }
  }
}
