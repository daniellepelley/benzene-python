  host.py       # {% if transport in ("aws-apigateway", "aws-sqs") %}builds the AWS Lambda app{% else %}builds the gRPC server{% endif %} (the only transport-specific file)
  main.py       # {% if transport in ("aws-apigateway", "aws-sqs") %}Lambda entry point ({{ project_slug }}.main.handler){% else %}server entry point (python -m {{ project_slug }}.main){% endif %}
